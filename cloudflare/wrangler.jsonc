{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "180-hitters-online",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "DartRoom" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "CLUB", "class_name": "ClubRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DartRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v3", "new_sqlite_classes": ["ClubRegistry"] }
  ],
  "secrets": { "required": ["CLUB_CODE", "ADMIN_SETUP_CODE"] },
  "observability": { "enabled": true }
}
